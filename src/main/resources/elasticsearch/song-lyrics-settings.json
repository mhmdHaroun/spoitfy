{
  "analysis": {
    "analyzer": {
      "lyrics_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "stop",
          "stemmer",
          "synonym_filter"
        ]
      },
      "keyword_lowercase": {
        "type": "custom",
        "tokenizer": "keyword",
        "filter": ["lowercase"]
      },
      "autocomplete_analyzer": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": [
          "lowercase",
          "autocomplete_filter"
        ]
      }
    },
    "filter": {
      "synonym_filter": {
        "type": "synonym",
        "synonyms": [
          "love,affection,adore",
          "sad,unhappy,melancholy,depressed",
          "happy,joyful,cheerful,glad",
          "night,evening,midnight",
          "day,morning,afternoon"
        ]
      },
      "autocomplete_filter": {
        "type": "edge_ngram",
        "min_gram": 2,
        "max_gram": 10
      },
      "stemmer": {
        "type": "stemmer",
        "language": "english"
      }
    }
  },
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "max_result_window": 10000
  }
}

